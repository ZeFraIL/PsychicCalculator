<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/lang_main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/mystical_bg"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="24dp"
    tools:context=".LanguageActivity">

    <TextView
        android:id="@+id/lang_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="serif"
        android:gravity="center"
        android:text="🔮 Choose Your Tongue\nВыберите Язык"
        android:textColor="@color/mystical_purple_glow"
        android:textSize="22sp"
        android:textStyle="bold" />

    <!-- Жуткий отсчет таймера -->
    <TextView
        android:id="@+id/timer_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginVertical="36dp"
        android:fontFamily="serif"
        android:gravity="center"
        android:text="⏳ 05"
        android:textColor="#FF5555"
        android:textSize="48sp"
        android:textStyle="bold" />

    <!-- Кнопка Английского -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_lang_en"
        android:layout_width="240dp"
        android:layout_height="56dp"
        android:layout_marginBottom="16dp"
        android:fontFamily="serif"
        android:text="🇬🇧 English"
        android:textColor="@color/white"
        android:textSize="18sp"
        android:textStyle="bold"
        app:backgroundTint="@color/mystical_purple_dark"
        app:cornerRadius="12dp"
        app:strokeColor="@color/mystical_purple"
        app:strokeWidth="1dp" />

    <!-- Кнопка Русского -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_lang_ru"
        android:layout_width="240dp"
        android:layout_height="56dp"
        android:fontFamily="serif"
        android:text="🇷🇺 Русский"
        android:textColor="@color/white"
        android:textSize="18sp"
        android:textStyle="bold"
        app:backgroundTint="@color/button_op_bg"
        app:cornerRadius="12dp"
        app:strokeColor="@color/mystical_purple_glow"
        app:strokeWidth="1dp" />

</LinearLayout>