<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/mystical_bg"
    tools:context=".MainActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="12dp">

        <!-- Верхняя панель: Заголовок и Превью камеры -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp">

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/camera_card"
                android:layout_width="80dp"
                android:layout_height="52dp"
                android:layout_alignParentEnd="true"
                app:cardBackgroundColor="#1A1A2E"
                app:cardCornerRadius="8dp"
                app:strokeColor="@color/mystical_purple"
                app:strokeWidth="1dp">

                <androidx.camera.view.PreviewView
                    android:id="@+id/preview_view"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:alpha="0.85" />
            </com.google.android.material.card.MaterialCardView>

            <TextView
                android:id="@+id/app_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentStart="true"
                android:layout_centerVertical="true"
                android:layout_toStartOf="@id/camera_card"
                android:fontFamily="serif"
                android:text="@string/title_psychic"
                android:textColor="@color/mystical_purple"
                android:textSize="20sp"
                android:textStyle="bold" />
        </RelativeLayout>

        <!-- Главное табло калькулятора -->
        <TextView
            android:id="@+id/display"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:background="@color/display_bg"
            android:fontFamily="serif"
            android:gravity="center_vertical|end"
            android:padding="12dp"
            android:text="0"
            android:textColor="@color/white"
            android:textSize="32sp"
            android:textStyle="bold" />

        <!-- Строка предсказания/чутья -->
        <TextView
            android:id="@+id/prediction_text"
            android:layout_width="match_parent"
            android:layout_height="36dp"
            android:fontFamily="serif"
            android:gravity="center"
            android:paddingHorizontal="8dp"
            android:text=""
            android:textColor="@color/mystical_purple_glow"
            android:textSize="14sp"
            android:textStyle="italic" />

        <!-- Индикатор энергии/ауры -->
        <TextView
            android:id="@+id/aura_text"
            android:layout_width="match_parent"
            android:layout_height="26dp"
            android:layout_marginBottom="8dp"
            android:background="#101E2E"
            android:fontFamily="serif"
            android:gravity="center"
            android:padding="2dp"
            android:text="@string/aura_default"
            android:textColor="@color/aura_green"
            android:textSize="12sp" />

        <!-- Панель Астральных Панелей (Транс, Таро, Голос) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/button_trance"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_marginEnd="4dp"
                android:layout_weight="2"
                android:fontFamily="serif"
                android:text="@string/trance_mode"
                android:textColor="@color/white"
                android:textSize="12sp"
                android:textStyle="bold"
                app:backgroundTint="@color/mystical_purple_dark"
                app:cornerRadius="10dp"
                app:strokeColor="@color/mystical_purple"
                app:strokeWidth="1dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/button_tarot"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_marginHorizontal="2dp"
                android:layout_weight="2"
                android:fontFamily="serif"
                android:text="@string/btn_tarot"
                android:textColor="#FFD700"
                android:textSize="12sp"
                android:textStyle="bold"
                app:backgroundTint="#241B3B"
                app:cornerRadius="10dp"
                app:strokeColor="#FFD700"
                app:strokeWidth="1dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/button_voice_toggle"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_marginStart="4dp"
                android:layout_weight="1.5"
                android:fontFamily="serif"
                android:text="@string/btn_voice_on"
                android:textColor="@color/aura_green"
                android:textSize="11sp"
                android:textStyle="bold"
                app:backgroundTint="#122A20"
                app:cornerRadius="10dp"
                app:strokeColor="@color/aura_green"
                app:strokeWidth="1dp" />
        </LinearLayout>

        <!-- Крупная сетка кнопок (4 столбца x 4 строки) -->
        <GridLayout
            android:id="@+id/button_grid"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:columnCount="4"
            android:rowCount="4">

            <!-- Строка 1: 7, 8, 9, / -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/button_7"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_columnWeight="1"
                android:layout_margin="4dp"
                android:layout_rowWeight="1"
                android:fontFamily="serif"
                android:text="7"
                android:textColor="@color/white"
                android:textSize="26sp"
                android:textStyle="bold"
                app:backgroundTint="@color/button_num_bg"
                app:cornerRadius="12dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/button_8"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_columnWeight="1"
                android:layout_margin="4dp"
                android:layout_rowWeight="1"
                android:fontFamily="serif"
                android:text="8"
                android:textColor="@color/white"
                android:textSize="26sp"
                android:textStyle="bold"
                app:backgroundTint="@color/button_num_bg"
                app:cornerRadius="12dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/button_9"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_columnWeight="1"
                android:layout_margin="4dp"
                android:layout_rowWeight="1"
                android:fontFamily="serif"
                android:text="9"
                android:textColor="@color/white"
                android:textSize="26sp"
                android:textStyle="bold"
                app:backgroundTint="@color/button_num_bg"
                app:cornerRadius="12dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/button_divide"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_columnWeight="1"
                android:layout_margin="4dp"
                android:layout_rowWeight="1"
                android:fontFamily="serif"
                android:text="÷"
                android:textColor="@color/white"
                android:textSize="26sp"
                android:textStyle="bold"
                app:backgroundTint="@color/button_op_bg"
                app:cornerRadius="12dp" />

            <!-- Строка 2: 4, 5, 6, * -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/button_4"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_columnWeight="1"
                android:layout_margin="4dp"
                android:layout_rowWeight="1"
                android:fontFamily="serif"
                android:text="4"
                android:textColor="@color/white"
                android:textSize="26sp"
                android:textStyle="bold"
                app:backgroundTint="@color/button_num_bg"
                app:cornerRadius="12dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/button_5"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_columnWeight="1"
                android:layout_margin="4dp"
                android:layout_rowWeight="1"
                android:fontFamily="serif"
                android:text="5"
                android:textColor="@color/white"
                android:textSize="26sp"
                android:textStyle="bold"
                app:backgroundTint="@color/button_num_bg"
                app:cornerRadius="12dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/button_6"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_columnWeight="1"
                android:layout_margin="4dp"
                android:layout_rowWeight="1"
                android:fontFamily="serif"
                android:text="6"
                android:textColor="@color/white"
                android:textSize="26sp"
                android:textStyle="bold"
                app:backgroundTint="@color/button_num_bg"
                app:cornerRadius="12dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/button_multiply"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_columnWeight="1"
                android:layout_margin="4dp"
                android:layout_rowWeight="1"
                android:fontFamily="serif"
                android:text="×"
                android:textColor="@color/white"
                android:textSize="26sp"
                android:textStyle="bold"
                app:backgroundTint="@color/button_op_bg"
                app:cornerRadius="12dp" />

            <!-- Строка 3: 1, 2, 3, + -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/button_1"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_columnWeight="1"
                android:layout_margin="4dp"
                android:layout_rowWeight="1"
                android:fontFamily="serif"
                android:text="1"
                android:textColor="@color/white"
                android:textSize="26sp"
                android:textStyle="bold"
                app:backgroundTint="@color/button_num_bg"
                app:cornerRadius="12dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/button_2"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_columnWeight="1"
                android:layout_margin="4dp"
                android:layout_rowWeight="1"
                android:fontFamily="serif"
                android:text="2"
                android:textColor="@color/white"
                android:textSize="26sp"
                android:textStyle="bold"
                app:backgroundTint="@color/button_num_bg"
                app:cornerRadius="12dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/button_3"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_columnWeight="1"
                android:layout_margin="4dp"
                android:layout_rowWeight="1"
                android:fontFamily="serif"
                android:text="3"
                android:textColor="@color/white"
                android:textSize="26sp"
                android:textStyle="bold"
                app:backgroundTint="@color/button_num_bg"
                app:cornerRadius="12dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/button_plus"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_columnWeight="1"
                android:layout_margin="4dp"
                android:layout_rowWeight="1"
                android:fontFamily="serif"
                android:text="+"
                android:textColor="@color/white"
                android:textSize="26sp"
                android:textStyle="bold"
                app:backgroundTint="@color/button_op_bg"
                app:cornerRadius="12dp" />

            <!-- Строка 4: C, 0, =, - -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/button_clear"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_columnWeight="1"
                android:layout_margin="4dp"
                android:layout_rowWeight="1"
                android:fontFamily="serif"
                android:text="C"
                android:textColor="#FF6B6B"
                android:textSize="24sp"
                android:textStyle="bold"
                app:backgroundTint="@color/button_num_bg"
                app:cornerRadius="12dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/button_0"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_columnWeight="1"
                android:layout_margin="4dp"
                android:layout_rowWeight="1"
                android:fontFamily="serif"
                android:text="0"
                android:textColor="@color/white"
                android:textSize="26sp"
                android:textStyle="bold"
                app:backgroundTint="@color/button_num_bg"
                app:cornerRadius="12dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/button_equals"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_columnWeight="1"
                android:layout_margin="4dp"
                android:layout_rowWeight="1"
                android:fontFamily="serif"
                android:text="="
                android:textColor="@color/white"
                android:textSize="28sp"
                android:textStyle="bold"
                app:backgroundTint="@color/button_equals_bg"
                app:cornerRadius="12dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/button_minus"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_columnWeight="1"
                android:layout_margin="4dp"
                android:layout_rowWeight="1"
                android:fontFamily="serif"
                android:text="-"
                android:textColor="@color/white"
                android:textSize="26sp"
                android:textStyle="bold"
                app:backgroundTint="@color/button_op_bg"
                app:cornerRadius="12dp" />
        </GridLayout>
    </LinearLayout>

    <!-- Полноэкранный оверлей магии и искр -->
    <zeev.fraiman.psychiccalculator.ParticleSparkView
        android:id="@+id/particle_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

</FrameLayout>